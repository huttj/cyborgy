{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyborgy",
  "main": "src/index.ts",
  "account_id": "183aa6473d53e6c3f29cfa852ebfb58a",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI — used for Whisper transcription (free daily allocation)
  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyborgy",
      "database_id": "104ee1bf-1c95-446a-9b9e-98a4bbd46e0c"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Create with: wrangler r2 bucket create cyborgy-media
      "bucket_name": "cyborgy-media"
    }
  ],

  // Single hourly cron; src/index.ts dispatches pings / daily recap /
  // weekly recap based on the local hour in TIMEZONE (DST-proof).
  "triggers": { "crons": ["0 * * * *"] },

  "routes": [{ "pattern": "cyborgy.app", "custom_domain": true }],
  // Keep workers.dev alive alongside the custom domain — the Telegram webhook
  // targets it (DNS-independent), and attaching routes disables it by default.
  "workers_dev": true,

  "vars": {
    "TIMEZONE": "America/Los_Angeles",
    "PUBLIC_URL": "https://cyborgy.app"
  }

  // Secrets (set with `wrangler secret put <NAME>`):
  //   TELEGRAM_BOT_TOKEN      — from @BotFather
  //   TELEGRAM_WEBHOOK_SECRET — any random string; also passed to setWebhook
  //   ANTHROPIC_API_KEY       — console.anthropic.com
  //   AUTHORIZED_USER_ID      — your Telegram numeric user id (@userinfobot)
  //   SHORTCUT_TOKEN          — bearer token for the watch Shortcut POST
  //   DASHBOARD_KEY           — key for viewing the analysis dashboard
}
