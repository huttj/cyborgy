{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyborgy",
  "main": "src/index.ts",
  "account_id": "183aa6473d53e6c3f29cfa852ebfb58a",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI — used for Whisper transcription (free daily allocation)
  "ai": { "binding": "AI" },

  // Cloudflare Email Service: magic links and access-request mail, sent from
  // cyborgy.app (Email Sending must be on for the zone).
  "send_email": [{ "name": "EMAIL", "remote": true }],

  // Static files for the browser app (PWA manifest, service worker, icons).
  // A request that matches no file goes on to the Worker.
  "assets": { "directory": "./public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyborgy",
      "database_id": "104ee1bf-1c95-446a-9b9e-98a4bbd46e0c"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Create with: wrangler r2 bucket create cyborgy-media
      "bucket_name": "cyborgy-media"
    }
  ],

  // One cron every 10 minutes: each tick sweeps voice notes whose webhook
  // attempt was killed mid-pipeline; the :00 tick additionally dispatches
  // pings / daily recap / weekly recap by local hour in TIMEZONE (DST-proof).
  "triggers": { "crons": ["*/10 * * * *"] },

  // Persist console.log/error as searchable Workers Logs (dashboard → cyborgy
  // → Logs). Without this, background failures after the webhook ACK vanish.
  "observability": { "enabled": true },

  "routes": [{ "pattern": "cyborgy.app", "custom_domain": true }],
  // Keep workers.dev alive alongside the custom domain — the Telegram webhook
  // targets it (DNS-independent), and attaching routes disables it by default.
  "workers_dev": true,

  "vars": {
    "TIMEZONE": "America/Los_Angeles",
    "PUBLIC_URL": "https://cyborgy.app"
  }

  // Secrets (set with `wrangler secret put <NAME>`):
  //   ANTHROPIC_API_KEY       — console.anthropic.com
  //   SHORTCUT_TOKEN          — bearer token for the watch Shortcut POST
  //   VAPID_PUBLIC_KEY        — web push (optional): `npm run vapid` prints both
  //   VAPID_PRIVATE_KEY       —   keys; the private one is a P-256 JWK
  //   ADMIN_EMAILS            — comma-separated admin emails; they approve signups
  // Optional Telegram bot (all three, or none):
  //   TELEGRAM_BOT_TOKEN      — from @BotFather
  //   TELEGRAM_WEBHOOK_SECRET — any random string; also passed to setWebhook
  //   AUTHORIZED_USER_ID      — your Telegram numeric user id (@userinfobot)
}
